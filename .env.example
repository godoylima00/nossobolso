# 1. Configuração do Supabase (Banco de Dados em Nuvem em Tempo Real)
# Encontrado em: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. Chave Opcional da API Google Gemini (Leitura IA de Faturas PDF e Prints)
VITE_GEMINI_API_KEY=
