# ============================================================================
# NOSSO BOLSO (GODOY-APP) - VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para ".env" (ou preencha em env-local.js / Modal de Configurações)
# ============================================================================

# 1. Configuração do Firebase Firestore (Banco de Dados em Nuvem em Tempo Real)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2. Chave Opcional da API Google Gemini (Leitura IA de Faturas PDF e Prints)
VITE_GEMINI_API_KEY=
